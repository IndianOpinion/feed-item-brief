<?xml version="1.0"?>
<ruleset name="feed-item-brief">
    <description>PSR-12 for the plugin and its tests.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>feed-item-brief.php</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!-- Entry points and test stubs declare symbols and run code by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>feed-item-brief.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>src/autoload.php</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>
    <!-- WordPress and WP-CLI names: wpdb, WP_Post, WP_CLI and friends. -->
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/Unit/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/Unit/UninstallTest.php</exclude-pattern>
    </rule>
    <rule ref="PSR2.Methods.MethodDeclaration.Underscore">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
</ruleset>
