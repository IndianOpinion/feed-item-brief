{
    "name": "indianopinion/feed-item-brief",
    "description": "WordPress plugin that turns one feed item into an attributed summary draft with the source link, byline and publish time kept, for any importer or none.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "rss", "feed", "summary", "attribution", "news", "llm"],
    "homepage": "https://github.com/IndianOpinion/feed-item-brief",
    "support": {
        "issues": "https://github.com/IndianOpinion/feed-item-brief/issues",
        "source": "https://github.com/IndianOpinion/feed-item-brief",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org",
            "homepage": "https://indianopinion.org"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IndianOpinion/llm-json-php"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "indianopinion/llm-json-php": "^0.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "simplepie/simplepie": "^1.8",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "indianopinion/llm-json-php": "Needed unless the site supplies its own summariser through the feed_item_brief_summarise filter."
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\FeedItemBrief\\": "src/"
        },
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\FeedItemBrief\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
